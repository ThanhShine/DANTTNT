# ============================================================
# ENVIRONMENT VARIABLES - SALES AI BACKEND
# Sao chép file này thành .env và điền giá trị thực
# ============================================================

# Server
NODE_ENV=development
PORT=5000

# Database MySQL
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=your_mysql_password_here
DB_NAME=sales_ai_system
DB_CONNECTION_LIMIT=10

# JWT
JWT_SECRET=your_super_secret_jwt_key_min_32_chars_here_change_this
JWT_EXPIRES_IN=7d
JWT_REFRESH_SECRET=your_refresh_token_secret_key_here_change_this
JWT_REFRESH_EXPIRES_IN=30d

# bcrypt
BCRYPT_ROUNDS=12

# CORS
FRONTEND_URL=http://localhost:3000

# Upload
UPLOAD_DIR=uploads
MAX_FILE_SIZE_MB=10

# AI Service (Python) - dùng ở Giai đoạn 5
AI_SERVICE_URL=http://localhost:8000

# Rate Limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100
